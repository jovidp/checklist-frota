# ============================================================================
#  CHECKLIST DE CAMINHÕES — modelo de configuração
#
#  Copie este arquivo para ".env" (mesma pasta) e ajuste o que for necessário.
#  Windows / Prompt de Comando:   copy .env.example .env
#
#  Todas as linhas abaixo são OPCIONAIS: se você apagar qualquer uma delas,
#  o sistema usa o valor padrão indicado no comentário.
# ============================================================================


# ---------------------------------------------------------------------------
# Porta em que o servidor vai atender (endereço http://localhost:PORTA)
# Troque apenas se a porta 3000 já estiver ocupada por outro programa.
# Padrão: 3000
# ---------------------------------------------------------------------------
PORT=3000


# ---------------------------------------------------------------------------
# Segredo usado para assinar os tokens de login (JWT).
# Deixe em branco e o próprio sistema gera um segredo forte na primeira
# execução, guardando-o em "data/.segredo".
# Se você preencher, use um texto longo e aleatório (mínimo 32 caracteres)
# e NUNCA compartilhe nem versione este valor.
# Padrão: gerado automaticamente em data/.segredo
# ---------------------------------------------------------------------------
JWT_SEGREDO=


# ---------------------------------------------------------------------------
# Por quantas horas o login continua válido antes de pedir a senha de novo.
# Padrão: 12
# ---------------------------------------------------------------------------
JWT_EXPIRA_HORAS=12


# ---------------------------------------------------------------------------
# Arquivo do banco de dados SQLite.
# Caminho relativo é resolvido a partir da pasta do projeto.
# Padrão: data/checklist.db
# ---------------------------------------------------------------------------
DB_ARQUIVO=data/checklist.db


# ---------------------------------------------------------------------------
# Pasta onde as fotos dos checklists são gravadas em disco.
# Padrão: data/uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=data/uploads


# ---------------------------------------------------------------------------
# Tamanho máximo aceito por foto, em megabytes (já decodificada).
# Fotos maiores são recusadas com a mensagem "Imagem acima do limite".
# Padrão: 5
# ---------------------------------------------------------------------------
MAX_FOTO_MB=5


# ---------------------------------------------------------------------------
# Quantidade máxima de fotos que um mesmo checklist pode ter.
# Padrão: 20
# ---------------------------------------------------------------------------
MAX_FOTOS_CHECKLIST=20


# ---------------------------------------------------------------------------
# Usuário administrador criado automaticamente pelo comando "npm run seed".
# NÃO existe senha padrão. Deixando ADMIN_SENHA em branco, o seed gera uma
# senha aleatória, mostra-a uma única vez no console e o sistema exige a troca
# no primeiro acesso. Se preencher ADMIN_SENHA, use uma senha forte e própria.
# Padrão do e-mail: admin@transporte.com
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@transporte.com
ADMIN_SENHA=


# ---------------------------------------------------------------------------
# Ambiente de execução. Use "producao" na máquina definitiva da empresa.
# Padrão: desenvolvimento
# ---------------------------------------------------------------------------
NODE_ENV=desenvolvimento
